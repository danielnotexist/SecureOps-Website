# Copy to .env and fill in. Vite only exposes VITE_-prefixed vars to the
# browser -- never put the service-role key or the Resend key here, they
# belong in the edge function's secrets (see below).

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# --- Not part of this file. Set as edge function secrets instead: ---
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set LEAD_NOTIFY_TO=sales@secureops.co.il
#   supabase secrets set LEAD_NOTIFY_FROM=no-reply@secureops.co.il
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
