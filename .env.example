# Copy to .env and fill in. Vite only exposes VITE_-prefixed vars to the
# browser -- that's fine here, the anon key can only INSERT into `leads`,
# never read it back (see the RLS policies on that table).

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# Delivery itself (the `new-lead-email` trigger -> notify-new-lead edge
# function -> Resend) already exists in this Supabase project from the old
# site and needs no new setup here -- only the RESEND_API_KEY project secret
# has to be current, set via the Supabase dashboard or:
#   supabase secrets set RESEND_API_KEY=re_xxx --project-ref <project-ref>
